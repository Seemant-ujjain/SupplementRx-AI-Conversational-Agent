      {
        "id": "product_composition",
        "question": "What ingredients and forms does this label declare?",
        "nodes": [
          "ProductLabel",
          "IngredientOccurrence"
        ],
        "relationships": [
          "DECLARES_OCCURRENCE",
          "HAS_DECLARED_FORM",
