{
  "schema_id": "supplementrx-schema-bounds",
  "version": "1.0.0",
  "status": "retrospective POC design specification; not clinical approval",
  "graph": "data/graph/full-graph-concepts-v1-08c99550a0fa0f86aca9",
  "graph_manifest_sha256": "08c99550a0fa0f86aca938bb952d6c682a2aa7affae3926a2115cc2f236d869b",
  "definitions": {
    "lower_bound": "Minimum representational capabilities for the declared POC question families; presence of types is not proof of answerability for every record.",
    "upper_bound": "Closed permitted type, endpoint and top-level property vocabulary for this version, adopted from the current export; extensions require a new schema version.",
    "relationship": "Lower-bound types/relations must be subsets of upper-bound types/relations. The instance graph must conform to the upper bound and the scoped lower-bound constraints.",
    "unknowns": "Required property presence does not require a known clinical value; null and source field-state distinctions remain valid. No minimum mapping per ingredient or claim per product.",
    "nested_properties": "Nested original_fields, attributes, provenance and other objects retain their existing source-specific contracts; this bounds layer checks top-level types and explicitly named claim fields, not every nested source key."
  },
  "design_basis": [
    "notebooks/Schema_Design_and_Mapping.ipynb",
    "data/evaluation/retrieval_questions_v1.json",
    "schemas/poc_preprocessing_contract_v0.1.json"
  ],
