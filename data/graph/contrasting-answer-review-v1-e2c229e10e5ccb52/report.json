        {
          "claim_id": "claim:eebb885776a41b2ded96c9f777d2e48d3f9e332abe785834e7f20f0071e50b65",
          "clinical_approval": false,
          "evidence_ids": [
            "creatine-expansion-evidence:bb31f2d084c3a3c8acfddf2f071830681e06e633737ab5d9bd5fd7c78b53c455",
            "creatine-expansion-evidence:2ffd3e41b8903867d168f5dca571ce0b6239162d4ecde738eb7550e48be249d7",
