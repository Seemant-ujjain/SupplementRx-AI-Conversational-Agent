  "statements": [
    {
      "type": "Formula re: Contains",
      "notes": "NewRhythm Probiotics is formulated with the 20 most clinically studied human probiotic strains. It's scientifically proven to survive harsh stomach acids and reach your intestinal tract, where they exert their greatest benefits. Organic Prebiotic Fiber Blend is designed to aid in the maintenance of probiotic activity in the intestine."
    },
    {
      "type": "Formulation re: Other",
      "notes": "This superior probiotic has been professionally formulated, handled, and tested to ensure maximum stability and full labeled potency.\nTargeted release\nShelf stable\nAcid and bile resistant\nScientifically studied"
    },
    {
      "type": "Formulation re: Vegetarian/Vegan",
      "notes": "Vegetarian"
    },
    {
      "type": "Storage",
      "notes": "No refrigeration required"
    },
    {
      "type": "Formulation re: Other",
      "notes": "Quality, purity, potency and freshness guaranteed"
    },
    {
      "type": "FDA Disclaimer Statement",
      "notes": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure or prevent any disease."
    },
    {
      "type": "Seals/Symbols",
      "notes": "Made in USA\nGMP Good Manufacturing Practice\nLab Tested 3rd Party Certified for Purity & Potency"
    },
    {
      "type": "Storage",
      "notes": "Probiotics are sensitive to moisture and heat. Contact us for storage tips if necessary."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "100% satisfaction guaranteed"
    },
    {
      "type": "Formulation re: Other",
      "notes": "Targeted release\nClinically studied"
    },
    {
      "type": "Formula re: Contains",
      "notes": "20 strains scientifically proven\n50 billion CFU active cultures"
    },
    {
      "type": "Formulation re: Other",
      "notes": "Each high quality vegetable capsule ensures delivery right into the intestinal tract\nFormulated with prebiotics\nHelp maintain digestive health and immune health"
    },
    {
      "type": "FDA Statement of Identity",
      "notes": "Dietary Supplement"
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Directions: As a dietary supplement, take two (2) veggie capsules daily or as directed by a healthcare professional.\nFor intensive use: take two (2) veggie capsules twice daily.\nIn rare cases, some people may experience stomach upset due to Probiotics Cleansing Effect. This is positive sign as high potency probiotics are removing waste or toxic substances from the body. To avoid reaction, it's recommended to start with a lower dosage and slowly increase."
    },
    {
      "type": "Formula re: Contains",
      "notes": "Contains a minimum of 50 billion active live bacteria when manufactured, and provides an effective level until at least the \"best by\" date."
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "Does Not Contain: Gluten, soy, corn, lactose, egg, fish, shellfish, milk, tree nuts, rice, sugar, wheat, yeast, starch, peanuts, fillers, binders, sulfates, sodium, artificial ingredients, colors, flavors, or magnesium stearate."
    },
    {
      "type": "Precautions re: Pregnant or Nursing or Prescription Medications",
      "notes": "Warning: If you are pregnant, nursing, taking any medications, including blood thinners, planning any medial or surgical procedure or have any medical condition, consult your doctor before use."
    },
    {
      "type": "Precautions re: Children",
      "notes": "Keep out of reach of children."
    },
    {
      "type": "Storage",
      "notes": "Store at room temperature or below, and avoid moisture."
    },
    {
      "type": "Formulation re: Other",
      "notes": "Made in a GMP Compliant Facility in the USA"
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "Verified non-GMO"
    }
