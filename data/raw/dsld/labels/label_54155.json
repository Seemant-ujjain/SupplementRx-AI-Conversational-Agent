  "statements": [
    {
      "type": "Precautions re: All Other",
      "notes": "This product is intended for use under adult supervision only."
    },
    {
      "type": "Precautions re: Children",
      "notes": "Keep out of reach of children."
    },
    {
      "type": "Storage",
      "notes": "Storage instructions:\nStore in a cool, dry place away from direct sunlight.\nStore at 15-30(0)C (59-86(0)F) Refrigeration is not required."
    },
    {
      "type": "Formula re: Contains",
      "notes": "Net Weight: 20 packets x 2.35g: 47g (1.60 oz)"
    },
    {
      "type": "General: Product/Version Code",
      "notes": "Tracking No.310H0040012"
    },
    {
      "type": "FDA Disclaimer Statement",
      "notes": "* These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure or prevent any disease."
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Directions:\nFor infants up to 3 years:\nEmpty entire content of 1 packet into cool food or drink. Mix until dissolved. Do not add to warm or hot food or beverage. Take 1 packet daily to support digestive and immune health. To alleviate occasional digestive distress, take 2 packets per day, one in the morning and one in thee evening. If conditions persist, consult your pediatrician.\nFor kids above 3: Take 1-2 packets per day for digestive and immune health."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Made in USA"
    },
    {
      "type": "Formula re: Type",
      "notes": "Formulated with 6 widely studied probiotic strains for infants and kids, LIFE Kids Probiotics helps populate your child's intestinal tract with \"friendly\" bacteria to support their natural defense and alleviate occasional digestive distress."
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "Unlike some products, which measure the number of probiotic cultures at time of manufacture, LIFE guarantees the stated number of live probiotic cultures through the expiration date on the box.**"
    },
    {
      "type": "Seals/Symbols",
      "notes": "Purity Guaranteed"
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "Kids Probiotics is FREE of:\nGluten, lactose, soy, yeast, wheat, gelatin, dairy, eggs, fish, shellfish, peanuts, tree nuts, sweeteners, artificial flavors and synthetic preservatives."
    },
    {
      "type": "Formula re: Contains",
      "notes": "6 Billion Active Cultures Guaranteed**\n6 Probiotic Strains"
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Supports kids natural defense systems*\nHelps reduce occasional digestive upset*\nEasy to take and flavorless"
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "Sugar, dairy & gluten free"
    },
    {
      "type": "FDA Statement of Identity",
