  "statements": [
    {
      "type": "Formula re: Contains",
      "notes": "Nutrilite Vitamin D is packed with 50 mcg of vitamin D - more than 16 cups fortified milk - which helps with calcium absorption into your bloodstream. It also includes vitamin K2 - which plays an important role in getting calcium from your bloodstream into your bones. It's made with mushrooms, one of nature's most potent botanical sources of vitamin D."
    },
    {
      "type": "Storage",
      "notes": "Keep tightly closed. Store in a cool, dry place."
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "No artificial colors or preservatives added."
    },
    {
      "type": "Precautions re: Children",
      "notes": "Children under 12 years of age, pregnant women or nursing mothers, or anyone with a medical condition should consult with a physician before taking this product. Keep out of reach of children."
    },
    {
      "type": "Precautions re: Pregnant or Nursing or Prescription Medications",
      "notes": "Children under 12 years of age, pregnant women or nursing mothers, or anyone with a medical condition should consult with a physician before taking this product. Patients on anticoagulant therapy should consult their physician before taking vitamin K2 supplements."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Quality you can trust since 1934"
    },
    {
      "type": "Formulation re: Other",
