  "statements": [
    {
      "type": "General Statements: All Other Content",
      "notes": "010018590716\nSkeletal system support"
    },
    {
      "type": "Formula re: Contains",
      "notes": "Magnesium is an essential mineral that is important to the function of every cell in the body. Organs such as the heart, brain, and kidneys require adequate levels of this mineral for proper function. Magnesium Complex combines a superior blend of two highly bioavailable forms of magnesium - citrate and malate. Magnesium citrate is an alkalizing form while magnesium malate has been found to promote musculoskeletal health."
    },
    {
      "type": "FDA Disclaimer Statement",
      "notes": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Recommentaion\nTake two capsules twice daily with a meal."
    },
    {
