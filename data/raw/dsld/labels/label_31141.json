  "statements": [
    {
      "type": "General: Product/Version Code",
      "notes": "CODE 533900 GOG"
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Directions: As a dietary supplement, take the contents of one pack daily. For optimal results, take 30 minutes prior to exercise. Do not take prior to bed. For individuals who want more flexibility with the timing of their thermogenic, the two Meta-Ignite(TM) tablets may be removed from the pack and taken separately at your convenience."
    },
    {
      "type": "Precautions re: Children",
      "notes": "KEEP OUT OF REACH OF CHILDREN."
    },
    {
      "type": "Storage",
      "notes": "Store in a cool, dry place."
    },
    {
      "type": "FDA Disclaimer Statement",
      "notes": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "GNC QUALITY COMMITMENT For more than 77 years, GNC has been the leader in the development of superior nutritional supplements. Our products are produced using only fresh, high-quality ingredients and are manufactured under the strictest quality controls."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "GNC GUARANTEE If you are not 100% completely satisfied, return the unused portion of the product with your receipt to a GNC store within 30 days. Our trained sales staff will either refund your purchase price or, if you prefer, assist you in finding a replacement product to help you LIVE WELL."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "NEW"
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "8-in-1 BODY CHISELING, POWER & PERFORMANCE SYSTEM^ ~ Clinically Researched, Full-Spectrum Multivitamin Complex ~ Achieve Razor-Sharp Detail & Definition ~ Extreme Energy, Focus, Workout Intensity and Performance ~ Unparalleled Strength, Plus Muscle Recovery & Joint Support"
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "VITAPAK(R) PROGRAM"
    },
    {
      "type": "Seals/Symbols",
      "notes": "GNX"
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "Powered by GNX Science(TM)"
    },
    {
      "type": "FDA Statement of Identity",
      "notes": "DIETARY SUPPLEMENT"
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "The Pursuit of Physical Perfection GNC Introduces the GNC GenetixHD(R) Elite Physique Vitapak(R) Program, the most cutting-edge combination of advanced body-sculpting tactics that leverage 8 clinically studied blends and a lean muscle-defining fitness plan designed to help you achieve the ultimate ripped, chiseled physique you've been striving for!*"
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "Elite Physique Vitapak(R) Works"
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "The key to GNX Science(TM) is its multi-pronged genomic approach to leveraging every last ounce of your true potential. It targets multiple metabolic pathways from every direction for unparalleled results."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "This breakthrough program targets more than 12 metabolic and biochemical pathways to fuel fat metabolism, triple the body's calorie burning,* support targeted nutrient optimization, amplify strength and exercise performance for intense muscle-defining workouts, promote lean muscle tone and superior body composition & fuel lean muscle recovery while supporting joint health and cell rejuvenation."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "In a randomized, double-blind clinical study of 57 healthy young adult males, subjects who took Creatine 189 Strength & Performance Support containing only 1.25 grams of creatine significantly improved leg press 1-RM performance by 54 lbs, while subject on 5 grams of creatine monohydrate improved by 52 lbs and the placebo group demonstrated no significant improvement."
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "Creatine 189 Strength & Performance Support: Proprietary creatine formula clinically shown to result in 189% more efficient uptake into muscles, allowing you to increase strength while taking only 25% of the dose of ordinary creatine. The system is designed to help you increase strength and physical performance even while dieting."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "In a clinical study of 17 healthy young adults, muscle biopsy results revealed that Creatine 189 Strength & Performance Support resulted in 189% greater muscle creatine uptake relative to benchmark amounts of ordinary creatine monohydrate powder."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Conforms to USP <2091> for weight.\n{Tablet} ACTUAL SIZE"
    }
  ],
