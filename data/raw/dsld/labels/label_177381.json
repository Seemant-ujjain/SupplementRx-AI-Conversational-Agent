    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "Nutrilite Vitamin D is a high potency dietary supplement."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Vitamin D is essential for calcium absorption into the bloodstream. Vitamin K2 plays an important role in getting calcium from your bloodstream into your bones."
    },
    {
      "type": "Formula re: Contains",
      "notes": "Naturally sourced from an extract of fermented soybeans, the vitamin K2 is the most bioavailable, longest lasting and most bioavailable form of vitamin K2."
    },
    {
      "type": "Storage",
      "notes": "Keep bottle tightly closed. Store in a cool, dry place."
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "No artificial colors or preservatives added."
    },
    {
      "type": "Precautions re: Children",
      "notes": "Children under 12 years of age, pregnant women or nursing mothers, or anyone with a medical condition should consult with a physician before taking this product. Keep out of reach of children."
    },
    {
      "type": "Precautions re: Pregnant or Nursing or Prescription Medications",
      "notes": "Children under 12 years of age, pregnant women or nursing mothers, or anyone with a medical condition should consult with a physician before taking this product."
    },
    {
      "type": "Precautions re: All Other",
