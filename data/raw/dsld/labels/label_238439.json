  "statements": [
    {
      "type": "Formulation re: Other",
      "notes": "Supports a strong immune system\nPromotes normal cognitive performance\nSupplements dietary deficiencies\nPromotes skeletal, muscle and skin health"
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Isotonix\nThe world's most advanced nutraceuticals"
    },
    {
      "type": "FDA Statement of Identity",
      "notes": "An Isotonic-Capable Dietary Supplement"
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Directions for use: Pour 1 level, white bottle capful of powder into the overcap. Add water to the line on the overcap (2 fl. oz./60 mL) and stir. As a dietary supplement, take once daily or as directed by your healthcare provider. Maximum absorption occurs when taken on an empty stomach. This product is isotonic only if the specified amounts of powder and water are used."
    },
    {
      "type": "Precautions re: Pregnant or Nursing or Prescription Medications",
      "notes": "Note: If you are currently using any prescription drugs, have an ongoing medical condition, or if you are pregnant or breastfeeding, you should consult your healthcare provider before using this product."
    },
    {
      "type": "Precautions re: Children",
      "notes": "Warning: Accidental overdose of iron-containing products is a leading cause of fatal poisoning in children under 6. Keep this product out of the reach of children. In case of accidental overdose, call a doctor or poison control center immediately."
    },
    {
      "type": "Formulation re: Vegetarian/Vegan",
      "notes": "This vegetarian product contains no added wheat, soy, yeast, gluten, artificial flavor, starch, salt, preservatives or milk."
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "This vegetarian product contains no added wheat, soy, yeast, gluten, artificial flavor, starch, salt, preservatives or milk."
    },
    {
      "type": "Storage",
      "notes": "Store in a cool, dry place."
    },
    {
      "type": "Precautions re: All Other",
      "notes": "Do not use if safety seal is broken or missing."
    },
    {
      "type": "FDA Disclaimer Statement",
      "notes": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure or prevent any disease."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Resale on third-party websites is strictly prohibited unless specifically authorized by Market America or its corporate affiliates. If barcodes are altered or you purchase this product from an unauthorized third-party website, the product is not guaranteed by Market America or its corporate affiliates."
    },
    {
      "type": "Formula re: Contains",
      "notes": "As Quatrefolic (6S)-5-methyltetrahydrofolic acid glucosamine salt)."
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
