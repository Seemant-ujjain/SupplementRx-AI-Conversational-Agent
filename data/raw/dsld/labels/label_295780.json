  "statements": [
    {
      "type": "General Statements: All Other Content",
      "notes": "Original formula"
    },
    {
      "type": "Formula re: Contains",
      "notes": "The only 3 year fermented food supplement with \r\nProbiotics\r\nPrebiotics\r\nPostbiotics"
    },
    {
      "type": "Formula re: Contains",
      "notes": "Live cultures"
    },
    {
      "type": "FDA Statement of Identity",
      "notes": "Dietary Supplement"
    },
    {
      "type": "Formula re: Contains",
      "notes": "Get more than just powder in a capsule-Dr. Ohhira’s Probiotics-The fermented food formula with all three elements listed below for positive probiotic health!\r\nFruits vegetables mushrooms seaweed\r\nLive probiotics\r\n12 select strains grown together never freeze-dried\r\nPost biotic metabolites\r\nHealth promoting nutrients from 3-year fermentation\r\n"
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Over 30 years ago renown Japanese microbiologist Dr. Lichiroh Ohhira proved that optimal intestinal health is achieved through a wide range of probiotics from fiber-rich foods, multiple synergistic strains of probiotics and the beneficial postbiotic metabolites they produce. His research led him to create the premier product to support digestion, immune health and promote a healthy microbiome.\r\n"
    },
    {
      "type": "FDA Disclaimer Statement",
      "notes": "These statements have not been evaluated by the Food and Drug administration. This product is not intended to diagnose, treat, cure or prevent any disease."
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "Does not contain milk, egg, fish, tree nuts, wheat (gluten), peanuts or soy allergens\r\nNon GMO"
    },
    {
      "type": "Formulation re: Vegetarian/Vegan",
      "notes": "100% Vegetarian"
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "Gluten free\r\nNon-dairy\r\nNon-GMO"
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Suggested use: take one (1) capsule twice daily with or without food. Usage can be safely increased as needed or as recommended by a healthcare provider."
    },
    {
      "type": "Precautions re: Children",
      "notes": "Warning: as with all dietary supplements, keep out of reach of children. If pregnant or nursing, or for children under 12 years, consult a healthcare professional about product usage.\r\n"
    },
    {
      "type": "Precautions re: Pregnant or Nursing or Prescription Medications",
      "notes": "Warning: as with all dietary supplements, keep out of reach of children. If pregnant or nursing, or for children under 12 years, consult a healthcare professional about product usage."
    },
    {
      "type": "Precautions re: All Other",
      "notes": "Tamper evident: Blister-packed to ensure product integrity. Do not use if foil blister pack is broken."
    },
    {
      "type": "Storage",
      "notes": "Refrigeration is not required.\r\n"
    },
