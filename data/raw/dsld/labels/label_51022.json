  "statements": [
    {
      "type": "General Statements: All Other Content",
      "notes": "why creafusion?\nCreatine is one of the most popular supplements today and that's not going to change any time soon. There is a great amount of research to support its performance-enhancing effects for a wide range of sports; from sports that demand intensive strength and endurance training like bodybuilding, weight lifting, Crossfit, cycling, and MMA to sports that require speed, such as sprinting, soccer, rowing, and swimming."
    },
    {
      "type": "Formula re: Contains",
      "notes": "Hit Creafusion is a cutting-edge, superior blend of 4 top-tier and highly-researched creatine powders: CreaPure (Creatine Monohydrate), COPMAX (Creatinol-O-Phosphate), Creatine Monohydrate Di-Creatine Malate, and Creatine MagnaPower (Magnesium Creatine Chelate)."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "By combining these varieties you get the benefits of all of them in one product to help you take it to the next level, no matter what you train for.\n~ Increase in muscle mass and enhanced strength\n~ Greater training capacity\n~ Reduced lactic acid\n~ Quicker muscle weight gain\n~ Antioxidant benefits\n~ More energy during workouts due to ATP regeneration"
    },
    {
      "type": "Seals/Symbols",
      "notes": "Good Manufacturing Practices cGMP"
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Manufactured in a cGMP Compliant Facility"
    },
    {
      "type": "FDA Disclaimer Statement",
      "notes": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."
    },
    {
      "type": "Seals/Symbols",
      "notes": "HIT"
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Pro Series"
    },
    {
      "type": "FDA Statement of Identity",
      "notes": "Dietary Supplement"
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "60 Servings"
    },
    {
      "type": "Seals/Symbols",
      "notes": "COPMax Creatine-O-Phosphate"
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Direction for use\nMix 1 scoop (5g) in 8 oz. of water, juice, or your protein drink of choice before and after training. Drink immediately. A loading phase is not required or recommended with this product. Drink at least 8 to 10 glasses (8 oz) of water daily in order to maximize results."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "For use as a dietary supplement only"
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "Creatine MagnaPower is a registered trademark of Albion Laboratories, Inc. This product is covered by US Patent number 5,516,925 and patents pending."
    },
    {
      "type": "Precautions re: Children",
      "notes": "Warnings\nKeep out of reach of children."
    },
    {
      "type": "Precautions re: All Other",
      "notes": "Check with a qualified health care professional before taking this product."
    },
    {
      "type": "Precautions re: Pregnant or Nursing or Prescription Medications",
      "notes": "Do not take if you are pregnant or nursing."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Allergen Information\nManufactured in an allergen free facility."
    },
    {
      "type": "Storage",
      "notes": "Store in a cool, dry place with lid tightly closed to protect freshness."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Moisture allowed into the container may case clumping and hardening and/or slightly different smell. Clumping or hardening does not change the effectiveness of this product."
