  "statements": [
    {
      "type": "General Statements: All Other Content",
      "notes": "Enzymedica Supports\nAHA Autism Hope Alliance\nVitamin Angels\nProud Supporter\nGreen Mountain Energy"
    },
    {
      "type": "FDA Disclaimer Statement",
      "notes": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure or prevent any disease."
    },
    {
      "type": "Formulation re: Other",
      "notes": "Enzyme deficiencies may result from a combination of age, diet and lifestyle. These deficiencies can lead to a variety of digestive discomforts, including occasional gas, bloating, irregularity and indigestion.\nFortifying the digestive system with enzymes and probiotics may promote optimal digestion while maintaining the digestive system's natural balance to support overall digestive health.\nDigest Gold +Probiotics contains an advanced formula that breaks down carbohydrates, fats, fiber and protein. Probiotics provide additional digestive support by boosting enzyme production and promoting regularity."
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Recommended Use: Take 1 capsule each meal. More may be taken as needed.\n"
    },
    {
      "type": "Formula re: Contains",
      "notes": "Thera-blend is an exclusive process that combines multiple strains of enzymes that work in various pH levels. Thera-blend enzymes have been shown to be three times stronger and work more than six times faster than leading digestive supplements.\n"
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "For more information, visit www.enzymedica.com."
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "When taken 3 times daily.\t\n"
    },
