  "statements": [
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Directions: Take 1 serving (3 easy-to-swallow veggie capsules) 2 times daily, 30 to 60 minutes before your 2 largest meals. Do not snack between meals or before bed. Do not exceed 2 servings (6 capsules) in a 24-hour period. Combine with diet and exercise. For best results, use for 60 days. Read the entire label before use and follow directions provided."
    },
    {
      "type": "Precautions re: All Other",
      "notes": "Warning: For adult use only."
    },
    {
      "type": "Precautions re: Pregnant or Nursing or Prescription Medications",
      "notes": "Take a few hours before or after taking other medications."
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "Take a few hours before or after taking other medications."
    },
    {
      "type": "Precautions re: All Other",
      "notes": "Childbearing age women should limit daily vitamin A intake to 10,000 IU (excludes beta-carotene). Consult a doctor before use if you have a medical condition and before starting a diet or exercise program."
    },
    {
      "type": "Precautions re: Children",
      "notes": "KEEP OUT OF REACH OF CHILDREN."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Average weight loss with key ingredient (200mg of green coffee bean extract) was 10.95 lbs. in a 60-day study with a low-calorie diet, and 3.7 lbs. in a separate 8-week study with calorie-reduced diet and moderate exercise."
    },
    {
      "type": "Precautions re: All Other",
      "notes": "Do not use if packaging has been tampered with."
    },
    {
      "type": "Precautions re: Pregnant or Nursing or Prescription Medications",
      "notes": "Do not use if pregnant or nursing."
    },
    {
      "type": "Precautions re: Children",
      "notes": "Accidental overdose of iron-containing products is a leading cause of fatal poisoning in children under 6. In case of accidental overdose, call a medical doctor or poison control center immediately."
    },
    {
      "type": "Storage",
      "notes": "Store in a cool, dry place (60(0)F to 80(0)F)."
    },
    {
