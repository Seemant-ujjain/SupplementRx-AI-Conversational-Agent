      "notes": "DOUBLE VERIFIED GLUTEN FREE(TM)"
    },
    {
      "type": "Suggested/Recommended/Usage/Directions",
      "notes": "SUGGESTED USE: Take three capsules daily, preferably with meals, in divided doses, or as directed by your healthcare practitioner."
    },
    {
      "type": "Formulation re: Does NOT Contain",
      "notes": "CONTAINS NO artificial colors, flavors or preservatives; no wheat, gluten, milk, eggs, peanuts, tree nuts, soy, crustacean shellfish or fish."
