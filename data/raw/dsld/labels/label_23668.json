  "statements": [
    {
      "type": "General Statements: All Other Content",
      "notes": "Magnesium is an essential electrolyte mineral involved in maintaining proper cardiovascular, nerve, and muscle health. The primary function is to activate enzymes. More than half of the body's magnesium is stored in the bones, 27% in muscle and the remainder in soft body tissues, cells and fluids. Magnesium is critical in energy production."
    },
    {
      "type": "Brand IP Statement(s) re: (c), (TM), (SM)",
      "notes": "Our Mega Magnesium(R) contains a combination of three different forms of magnesium."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "WE GUARANTEE OUR SUPPLEMENTS FOR POTENCY AND PURITY"
    },
    {
      "type": "FDA Disclaimer Statement",
      "notes": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."
    },
    {
      "type": "General Statements: All Other Content",
      "notes": "Promotes Optimal Muscle, Nerve, and Bone Health"
    },
    {
      "type": "FDA Statement of Identity",
      "notes": "Dietary Supplement"
    },
    {
